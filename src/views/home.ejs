<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home <%= user.user_name %>
</title>
    <link rel="stylesheet" href="/css/home.css">
</head>

<body>


    <div class="container">
        <!-- Left Sidebar -->
        <nav class="sidebar">
            <a href="#" class="nav-item active">Home</a>
            <a href="#" class="nav-item" id="gotoProfile">Profile</a>
            <div class="logout-section">
                <h2 id="logout">Log out</h2>
            </div>
        </nav>

        <!-- Center Feed -->
        <main class="feed">
            <header>
                <h1>Hola 👋 <a href="/user/profile/<%= user.user_name %>"> <%= user.first_name %></a>
                        <div id="toast-container"></div>

                </h1>
                <div class="tweet-composer">
                    <div class="avatar-placeholder">
                        <a href="/user/profile/<%= user.user_name %>">
                        <img src="/<%= user.profile_pic_url %>" alt="Profile">
                        </a>
                    </div>
                    <form id="tweetForm">
                        <input type="text" placeholder="What is happening?!" id="tweet_content" name="tweet_content">

                        <div id="image-preview-container" style="display: none;">
                            <img id="image-preview" src=""
                                style="max-width: 100%; border-radius: 15px; margin-bottom: 10px;">
                            <button type="button" id="remove-img"
                                style="position: absolute; z-index: 9999; cursor: pointer;">✕</button>
                        </div>

                        <div class="composer-actions">
                            <label for="tweet_img" style="cursor: pointer; color: #1d9bf0;">🖼️ Add Photo</label>
                            <input type="file" id="tweet_img" name="tweet_img" accept="image/*" style="display: none;" >
                            <span id="input-char-count"></span>
                            <button type="submit" class="tweet-btn">Post</button>
                        </div>
                    </form>
                </div>
            </header>



            <div class="tweets-list" id="tweets-list">
                <% feed.forEach(tweet=> { %>
                    <div class="tweet-card" id="tweet_<%= tweet.tweet_id %>">
                        <span class="retweet-info">
                            <%= (tweet.post_type==="retweet" ) ? `↳↰ Reposted BY ${tweet.retweeter_name}` : "" %>
                        </span>
                        <br>
                        <div class="tweet-header">
                            <img src="/<%= tweet.profile_pic_url %>" alt="Profile" class="tweet-avatar">
                            <div class="tweet-header-info">
                                <span class="tweet-username">
                                    <%= tweet.first_name %>
                                        <%= tweet.last_name %>
                                         <%- (tweet.email_verified === 1) ? `<img src="/media/bedge_2.png" alt="verified badge" class="verified-badge" width="25px" height="25px">` : "" %>
                                </span>
                                <a href="/user/profile/<%=tweet.user_name%>" target="_blank">
                                    <span class="tweet-handle">@<%= tweet.user_name %></span>
                                </a>
                            </div>
                            <!-- Edit/Delete stays in header for correct alignment -->
                            <div id="tweet-edit-delete-div"
                                style=`display: <%= tweet.user_id === user.user_id ? 'flex' : 'none' %>;`>
                
                                <span class="del_tweet" data-tweet-id="<%= tweet.tweet_id %>"
                                    id="<%= tweet.tweet_id %>_del">Delete</span>
                            </div>
                            <div id="tweet-share" style="padding-left: 10px;">
                                <span id="share_tweet_<%tweet.tweet_id%>" class="share-tweet"
                                    data-tweet-link="<%= tweet.user_name %>/<%= tweet.tweet_id %>">🔗</span>
                            </div>
                        </div>

                        <p class="tweet-content" id="<%= tweet.tweet_id %>">
                            <%= tweet.content %>
                        </p>

                        <% if (tweet.image_url) { %>
                            <img src="/<%= tweet.image_url %>" alt="Tweet Image" class="tweet-image">
                            <% } %>

                                <div class="tweet-actions">
                                    <!-- Like Form -->
                                    <form class="like-tweet-form">
                                        <span class="action-btn like-btn <%= tweet.isLiked ? 'active-like' : '' %>"
                                            id="like-container-<%= tweet.tweet_id %>">
                                            <input type="hidden" name="tweet_id" value="<%= tweet.tweet_id %>">
                                            <button type="submit"
                                                style="background: none; border: none; cursor: pointer; color: inherit; font-size: inherit;">
                                                <span class="heart-icon">
                                                    <%= tweet.isLiked ? "❤️" : "🤍" %>
                                                </span>
                                            </button>
                                            <span class="count_likes">
                                                <%= tweet.likes_count %>
                                            </span>
                                        </span>
                                    </form>

                                    <!-- Retweet Form -->
                                    <form class="retweet-form">
                                        <span
                                            class="action-btn retweet-btn <%= tweet.isRetweeted ? 'active-retweet' : '' %>"
                                            id="retweet-container-<%= tweet.tweet_id %>">
                                            <input type="hidden" name="tweet_id" value="<%= tweet.tweet_id %>">
                                            <button type="submit"
                                                style="background: none; border: none; cursor: pointer; color: inherit; font-size: inherit;">
                                                <span class="retweet-icon">
                                                    <%= tweet.isRetweeted ? "🔂" : "🔁" %>
                                                </span>
                                            </button>
                                            <span class="count_retweets">
                                                <%= tweet.retweet_count %>
                                            </span>
                                        </span>
                                    </form>

                                    <!-- Comment Form -->
                                    <% const uniqeId=tweet.shared_id %>
                                        <form class="comment-form">
                                            <span class="action-btn comment-btn"
                                                id="comment-container-<%= tweet.tweet_id %>">
                                                <input type="hidden" name="tweet_id" value="<%= tweet.tweet_id %>">
                                                <input type="hidden" name="unique_id" value="<%= uniqeId %>">
                                                <button type="submit"
                                                    style="background: none; border: none; cursor: pointer; color: inherit; font-size: inherit;">💬</button>
                                                <span class="count_comments" id="count_comment_<%= tweet.tweet_id %>">
                                                    <%= tweet.comment_count %>
                                                </span>
                                            </span>
                                        </form>
                                        <div class="comment-section"
                                            id="comment-section-<%= tweet.tweet_id %>-<%= uniqeId %>"
                                            style="display: none;">
                                            <div class="comment-input-area">
                                                <input type="text" placeholder="Write a reply..." class="comment-input"
                                                    id="comment-input-<%= tweet.tweet_id %>-<%= uniqeId %>">
                                                <button type="button" class="reply-btn"
                                                    id="reply-btn-<%= tweet.tweet_id %>-<%= uniqeId %>"
                                                    data-unique-id="<%= uniqeId %>"
                                                    data-tweet-id="<%= tweet.tweet_id %>">
                                                    Reply
                                                </button>
                                            </div>
                                            <div class="comments-list"
                                                id="comments-list-<%= tweet.tweet_id %>-<%= uniqeId %>">
                                                <!-- Comments load here -->
                                            </div>
                                        </div>
                                </div>
                                <div class="tweet-meta">
                                    <span class="tweet-time" data-time="<%= tweet.created_at %>"></span>
                                </div>
                    </div>
                    <% }) %>
            </div> 
        </main>


        <!-- Right Sidebar -->
        <aside class="widgets">
            <div class="search-box">
                <input id="serch_user" type="text" placeholder="Search">
            </div>
            <div class="search_results">

            </div>
            <br><br>
            <div class="suggested-users">
                <h3>People you may like to know....</h3>
                <br><br>
                <div class="suggested-user" id="suggested-users-container">
                    <% suggestedUsers.forEach(element=> { %>
                        <div class="suggested-user-card">
                            <div class="suggested-avatar">
                                <img src="/<%= element.profile_pic_url %>" alt="Profile">
                            </div>
                            <div class="suggested-user-info">
                                <span class="suggested-display-name">
                                    <%= element.first_name %>
                                        <%= element.last_name %>
                                </span>
                                <a href="/user/profile/<%=element.user_name%>" target="_blank"><span
                                        class="suggested-handle">@<%= element.user_name %></span></a>
                            </div>
                            
                        </div>
                        <% }); %>
                </div>
            </div>
        </aside>
    </div>
    <script> let user_name = "<%= user.user_name %>"
        let user_id = "<%= user.user_id %>"
        let profile_pic_url = "<%= user.profile_pic_url %>"
    </script>
    <script src="/js/feed.js"></script>
    <script src="/js/home.js"></script>
</body>

</html>