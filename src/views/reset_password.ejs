<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password Page</title>
    <link rel="stylesheet" href="/css/reset_password.css">
</head>

<body>

    <div class="container">
        <div id="top">
            <h2>Reset your password</h2>
            <p>Enter the 6-digit code we showed you and your new password.</p>
        </div>

        <form id="resetForm">
            <div class="form-group">
                <input type="text" id="otp" name="otp" placeholder="6-digit OTP" maxlength="6" required
                    style="text-align: center; letter-spacing: 4px; font-weight: bold;">
                <p id="otp_error"></p>
            </div>

            <div class="form-group">
                <input type="password" id="newPassword" name="newPassword" placeholder="New password" required>
                <p id="password_error"></p>
            </div>

            <div class="form-group">
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password"
                    required>
                <p id="cpassword_error"></p>
            </div>

            <div id="errorMessage" class="error-msg"></div>

            <button type="submit" class="btn-black">Update Password</button>
        </form>

        <div style="text-align: center; margin-top: 15px;">
            <span id="timerText" style="font-size: 13px; color: #536471;">
                OTP Expire in : <span id="seconds">
                    <% 
                const distance = expiresAt - Date.now();
                const  timeLeft = Math.floor(distance / 1000)
                 %>

                 <%= timeLeft %>
                </span>
            </span>
            <div id="message" style="display: none;">
                TIME EXPIRED. Please request a new OTP.
            </div>
            <button id="resendBtn" type="button" disabled
                style="background: none; border: none; color: #1d9bf0; font-size: 13px; cursor: pointer; display: none;">
                Resend OTP
            </button>
        </div>
    </div>
    
</body>

<script>
    const serverExpiry = <%= expiresAt %>; 
</script>
<script src="js/reset_password.js"></script>
</html>