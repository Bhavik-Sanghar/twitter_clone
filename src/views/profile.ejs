<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= user.user_name %> (@<%= user.user_name %>) / Twitter
    </title>
    <link rel="stylesheet" href="/css/profile.css">
</head>

<body>
    <!-- Left Sidebar -->
    <nav class="sidebar">
        <div class="logo">𝕏</div>
        <a href="/user" class="nav-item active">Home</a>
        <%- isOwnProfile ? `<a href="/user/change-password" class="nav-item"> Change Password</a>` : "" %>
    </nav>

    <div class="profile-container">
        <!-- Header with Back Button and Tweet Count -->
        <div class="header">
            <button class="back-btn" onclick="window.history.back()">←</button>
            <div class="header-info">
                <h3>
                    <%= user.first_name %>
                        <%= user.last_name %>
                </h3>
                <span class="tweet-count">
                    <%= tweet_count || 0 %> Tweets
                </span>
                <div id="toast-container"></div>
            </div>
        </div>

        <!-- Banner & Overlapping Avatar -->
        <div class="banner" style="background-image: url('/<%= user.cover_pic_url %>');">
            <div class="avatar">
                <img src="/<%= user.profile_pic_url %>" alt="Profile">
            </div>
        </div>

        <div class="profile-details">

            <div class="action-row">
                <% if (isOwnProfile) { %>
                    <!-- Show Edit button if it's the logged-in user's own profile -->
                    <button id="editProfile" class="btn-outline">Edit profile</button>
                    <% } else { %>
                        <form
                            action="/user/follow/<%= user.user_name %>/<%= user.user_id %>/<%= isFollowing ? 'unfollow' : 'follow' %>"
                            method="POST">
                            <button type="submit" class="<%= isFollowing ? 'btn-unfollow' : 'btn-follow' %>">
                                <%= isFollowing ? 'Following' : 'Follow' %>
                            </button>
                        </form>
                        <% } %>
            </div>


            <!-- Basic Info -->
            <div class="info-section">
                <h2 class="display-name">
                    <%= user.first_name %>
                        <%= user.last_name %>
                        <!-- <img src="/media/bedge.png" alt="verified badge" class="verified-badge" width="25px" height="25px"> -->
                        <% if (isOwnProfile) { %>
                                <span id="isVerified">
                                    <%- isVerified ? `<img src="/media/bedge_2.png" alt="verified badge" class="verified-badge" width="25px" height="25px">` : "<span id='verify_email'>Get Verfied $8 Only 😎 </span>" %>
                                </span>
                            <% } else { %>
                                <span id="isVerified">
                                    <%- isVerified ? `<img src="/media/bedge_2.png" alt="verified badge" class="verified-badge" width="25px" height="25px">` : "" %>
                                </span>
                            <% } %>
                </h2>
                <p class="handle">@<%= user.user_name %>
                </p>
                <p class="bio">
                    <%= user.bio || 'No bio yet.' %>
                </p>
            </div>

            <!-- Meta Data (Location, Web, Join Date) -->
            <div class="meta-data">
                <% if (user.location) { %>
                    <span>📍 <%= user.location %></span>
                    <% } %>
                        <% if (user.website) { %>
                            <span>🔗 <a href="<%= user.website %>" target="_blank" class="link">
                                    <%= user.website %>
                                </a></span>
                            <% } %>
                                <% if (user.birthdate) { %>
                                    <span>🎈 Born <%= new Date(user.birthdate).toLocaleDateString() %></span>
                                    <% } %>
                                        <span>📅 Joined <%= new Date(user.created_at).toLocaleDateString('en-IN', {
                                                month: 'long' , year: 'numeric' }) %></span>
                                        <span>
                                            TimeZone: <span id="user-tz">Detecting...</span>
                                        </span>

            </div>

            <!-- Follower/Following Counts (Clickable) -->
            <div class="stats-row">
                <a href="/user/followers/<%= user.user_id %>" class="stat-link">
                    <strong>
                        <%= following_count || 0 %>
                    </strong> <span class="stat-label">Following</span>

                    <strong>
                        <%= followers_count || 0 %>
                    </strong> <span class="stat-label">Followers</span>
                </a>
                <span class="tweet-count">
                    <%= tweet_count || 0 %> Tweets
                </span>
            </div>
        </div>

        <!-- Tabs for Tweets / Media / Likes (Twitter Style) -->
        <div class="profile-tabs">
            <div class="tab active" id="tweet_tab">Tweets</div>
            <!-- <div class="tab" id="replies_tab">Replies</div> -->
            <!-- <div class="tab">Media</div>
            <div class="tab">Likes</div> -->
        </div>

        <div class="tweets-list">
                <% tweets.forEach(tweet=> { %>
                    <div class="tweet-card" id="tweet_<%= tweet.tweet_id %>">
                        <span class="retweet-info">
                            <%= (tweet.post_type==="retweet" ) ? `↳↰ Reposted BY ${tweet.retweeter_name}` : "" %>
                        </span>
                        <br>
                        <div class="tweet-header">
                            <img src="/<%= tweet.profile_pic_url %>" alt="Profile" class="tweet-avatar">
                            <div class="tweet-header-info">
                                <span class="tweet-username">
                                    <%= tweet.first_name %>
                                        <%= tweet.last_name %>
                                         <%- (tweet.email_verified === 1) ? `<img src="/media/bedge_2.png" alt="verified badge" class="verified-badge" width="25px" height="25px">` : "" %>
                                </span>
                                <a href="/user/profile/<%=tweet.user_name%>" target="_blank">
                                    <span class="tweet-handle">@<%= tweet.user_name %></span>
                                </a>
                            </div>
                            <!-- Edit/Delete stays in header for correct alignment -->
                            <div id="tweet-edit-delete-div"
                                style="display: <%= tweet.user_id === user.user_id ? 'flex' : 'none' %>;">
                                <span class="del_tweet" data-tweet-id="<%= tweet.tweet_id %>"
                                    id="<%= tweet.tweet_id %>_del">Delete</span>
                            </div>
                            <div id="tweet-share" style="padding-left: 10px;">
                                <span id="share_tweet_<%tweet.tweet_id%>" class="share-tweet"
                                    data-tweet-link="<%= tweet.user_name %>/<%= tweet.tweet_id %>">🔗</span>
                            </div>
                        </div>

                        <p class="tweet-content" id="<%= tweet.tweet_id %>">
                            <%= tweet.content %>
                        </p>

                        <% if (tweet.image_url) { %>
                            <img src="/<%= tweet.image_url %>" alt="Tweet Image" class="tweet-image">
                            <% } %>

                                <div class="tweet-actions">
                                    <!-- Like Form -->
                                    <form class="like-tweet-form">
                                        <span class="action-btn like-btn <%= tweet.isLiked ? 'active-like' : '' %>"
                                            id="like-container-<%= tweet.tweet_id %>">
                                            <input type="hidden" name="tweet_id" value="<%= tweet.tweet_id %>">
                                            <button type="submit"
                                                style="background: none; border: none; cursor: pointer; color: inherit; font-size: inherit;">
                                                <span class="heart-icon">
                                                    <%= tweet.isLiked ? "❤️" : "🤍" %>
                                                </span>
                                            </button>
                                            <span class="count_likes">
                                                <%= tweet.likes_count %>
                                            </span>
                                        </span>
                                    </form>

                                    <!-- Retweet Form -->
                                    <form class="retweet-form">
                                        <span
                                            class="action-btn retweet-btn <%= tweet.isRetweeted ? 'active-retweet' : '' %>"
                                            id="retweet-container-<%= tweet.tweet_id %>">
                                            <input type="hidden" name="tweet_id" value="<%= tweet.tweet_id %>">
                                            <button type="submit"
                                                style="background: none; border: none; cursor: pointer; color: inherit; font-size: inherit;">
                                                <span class="retweet-icon">
                                                    <%= tweet.isRetweeted ? "🔂" : "🔁" %>
                                                </span>
                                            </button>
                                            <span class="count_retweets">
                                                <%= tweet.retweet_count %>
                                            </span>
                                        </span>
                                    </form>

                                    <!-- Comment Form -->
                                    <% const uniqeId=tweet.shared_id %>
                                        <form class="comment-form">
                                            <span class="action-btn comment-btn"
                                                id="comment-container-<%= tweet.tweet_id %>">
                                                <input type="hidden" name="tweet_id" value="<%= tweet.tweet_id %>">
                                                <input type="hidden" name="unique_id" value="<%= uniqeId %>">
                                                <button type="submit"
                                                    style="background: none; border: none; cursor: pointer; color: inherit; font-size: inherit;">💬</button>
                                                <span class="count_comments" id="count_comment_<%= tweet.tweet_id %>">
                                                    <%= tweet.comment_count %>
                                                </span>
                                            </span>
                                        </form>
                                        <div class="comment-section"
                                            id="comment-section-<%= tweet.tweet_id %>-<%= uniqeId %>"
                                            style="display: none;">
                                            <div class="comment-input-area">
                                                <input type="text" placeholder="Write a reply..." class="comment-input"
                                                    id="comment-input-<%= tweet.tweet_id %>-<%= uniqeId %>">
                                                <button type="button" class="reply-btn"
                                                    id="reply-btn-<%= tweet.tweet_id %>-<%= uniqeId %>"
                                                    data-unique-id="<%= uniqeId %>"
                                                    data-tweet-id="<%= tweet.tweet_id %>">
                                                    Reply
                                                </button>
                                            </div>
                                            <div class="comments-list"
                                                id="comments-list-<%= tweet.tweet_id %>-<%= uniqeId %>">
                                                <!-- Comments load here -->
                                            </div>
                                        </div>
                                </div>
                                <div class="tweet-meta">
                                    <span class="tweet-time" data-time="<%= tweet.created_at %>"></span>
                                </div>

                    </div>
                    <% }) %>
            </div>

        <div class="tweet-replies" id="tweet-replies" style="display: none;">
            <!-- Replies will be loaded here -->

        </div>
        <script>
            const userTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
            document.getElementById('user-tz').innerText = userTimezone;
        </script>
        <script>
            const user_name = "<%= user ? user.user_name : '' %>";
            const user_id = "<%= user ? user.user_id : '' %>";
        </script>
        <script src="/js/feed.js"></script>
        <script src="/js/profile.js"></script>
</body>

</html>